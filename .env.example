# =============================================================================
# SentinelOps — environment configuration
# Copy to `.env` and adjust. `.env` is git-ignored.
# =============================================================================

# ---- PostgreSQL + pgvector (incident memory store) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinelops
POSTGRES_USER=sentinelops
POSTGRES_PASSWORD=sentinelops
# JDBC URL the agent uses to reach Postgres (host networking from WSL/host).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sentinelops

# ---- LLM provider (OpenAI-compatible; works with OpenAI, Azure, vLLM, etc.) ----
# The agent talks to any OpenAI-compatible /v1 endpoint. Change base-url for
# self-hosted / Azure. Only the API key is secret.
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Embedding dimension MUST match the model above (3-small=1536, 3-large=3072).
EMBEDDING_DIMENSION=1536
# Embedding provider: 'local' (default, dependency-free, no key) or 'openai'.
EMBEDDING_PROVIDER=local

# ---- Kubernetes / cluster ----
KIND_CLUSTER_NAME=sentinelops
DEMO_NAMESPACE=sentinelops-demo
# Guardrail: the agent will REFUSE to act outside this namespace.
AGENT_ALLOWED_NAMESPACE=sentinelops-demo

# ---- Observability ----
# NodePort 30090 is mapped to the host by the kind config, so a host/WSL-run
# agent reaches in-cluster Prometheus here.
PROMETHEUS_URL=http://localhost:30090

# ---- Agent behaviour ----
# When true, the agent reasons + logs remediations but does NOT execute them.
AGENT_DRY_RUN=false
AGENT_RETRIEVAL_TOP_K=5
